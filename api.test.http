###############################################################################
# 9. TIRA — Reconciliation (role: tira, same login as everyone)
###############################################################################

### TIRA dashboard
GET {{baseUrl}}/tira/dashboard
Authorization: Bearer {{tiraToken}}
Accept: {{accept}}

### List premium records
GET {{baseUrl}}/tira/premiums?per_page=20
Authorization: Bearer {{tiraToken}}
Accept: {{accept}}

### List premiums — filters
# GET {{baseUrl}}/tira/premiums?status=reported&tira_premium_number={{tiraPremiumNumber}}&from_date=2026-01-01&to_date=2026-12-31
# Authorization: Bearer {{tiraToken}}

### Get premium record by ID
GET {{baseUrl}}/tira/premiums/{{premiumRecordId}}
Authorization: Bearer {{tiraToken}}
Accept: {{accept}}

### Get premium by platform number
GET {{baseUrl}}/tira/premiums/by-number/{{tiraPremiumNumber}}
Authorization: Bearer {{tiraToken}}
Accept: {{accept}}

### Reconcile premium — matched
POST {{baseUrl}}/tira/premiums/{{premiumRecordId}}/reconcile
Authorization: Bearer {{tiraToken}}
Content-Type: {{contentType}}
Accept: {{accept}}

{
  "status": "matched",
  "tira_system_amount": 1650.00,
  "notes": "Amounts match TIRA ledger"
}

### Reconcile premium — disputed
# POST {{baseUrl}}/tira/premiums/{{premiumRecordId}}/reconcile
# Authorization: Bearer {{tiraToken}}
# Content-Type: {{contentType}}
#
# {
#   "status": "disputed",
#   "tira_system_amount": 1600.00,
#   "notes": "Variance found in TIRA system"
# }

### Export reconciliation CSV
GET {{baseUrl}}/tira/reconciliation/export?from_date=2026-01-01&to_date=2026-12-31
Authorization: Bearer {{tiraToken}}
Accept: text/csv


###############################################################################
# 10. DEMO TIRA API — Simulates government receive endpoint
###############################################################################

### Demo: Notify paid premium (no user JWT — uses X-Demo-Tira-Key)
POST {{baseUrl}}/demo/tira/v1/premiums/notify-paid
Content-Type: {{contentType}}
Accept: {{accept}}
X-Demo-Tira-Key: {{demoTiraKey}}

{
  "tira_premium_number": "{{tiraPremiumNumber}}",
  "payment_status": "paid",
  "paid_at": "2026-05-25T10:30:00Z",
  "premium_amount": 1650.00,
  "currency": "USD",
  "payment_reference": "PAY-20260525-ABC12345",
  "insurer": {
    "name": "Marine Test Insurance Ltd",
    "registration_number": "BRELA-123456"
  },
  "policy_code": "MAR-ICC-A-001",
  "order_reference": "ORD-20260525-0001",
  "invoice_number": "INV-20260525-0001"
}

### Demo: Simulate rejection (?simulate=reject)
# POST {{baseUrl}}/demo/tira/v1/premiums/notify-paid?simulate=reject
# X-Demo-Tira-Key: {{demoTiraKey}}
# ...

### Demo inbox — list received (admin or tira)
GET {{baseUrl}}/demo/tira/v1/premiums
Authorization: Bearer {{tiraToken}}
Accept: {{accept}}

### Demo inbox — get by premium number
GET {{baseUrl}}/demo/tira/v1/premiums/{{tiraPremiumNumber}}
Authorization: Bearer {{tiraToken}}
Accept: {{accept}}


