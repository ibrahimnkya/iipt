Authorization: Bearer {{adminToken}}
Content-Type: {{contentType}}
Accept: {{accept}}

{
  "name": "New TIRA Officer",
  "email": "newtira@marine.test",
  "password": "password",
  "role": "tira"
}

### Admin — List currencies
GET {{baseUrl}}/admin/currencies
Authorization: Bearer {{adminToken}}
Accept: {{accept}}

### Admin — Create currency
POST {{baseUrl}}/admin/currencies
Authorization: Bearer {{adminToken}}
Content-Type: {{contentType}}
Accept: {{accept}}

{
  "code": "KES",
  "name": "Kenyan Shilling",
  "symbol": "KSh",
  "is_active": true
}

### Admin — Get currency
GET {{baseUrl}}/admin/currencies/{{currencyId}}
Authorization: Bearer {{adminToken}}
Accept: {{accept}}

### Admin — Update currency
PUT {{baseUrl}}/admin/currencies/{{currencyId}}
Authorization: Bearer {{adminToken}}
Content-Type: {{contentType}}
Accept: {{accept}}

{
  "name": "Kenyan Shilling",
  "is_active": true
}

### Admin — Delete currency
DELETE {{baseUrl}}/admin/currencies/{{currencyId}}
Authorization: Bearer {{adminToken}}
Accept: {{accept}}

### Admin — Get storage duration setting
GET {{baseUrl}}/admin/settings/storage-duration
Authorization: Bearer {{adminToken}}
Accept: {{accept}}

### Admin — Update storage duration
PATCH {{baseUrl}}/admin/settings/storage-duration
Authorization: Bearer {{adminToken}}
Content-Type: {{contentType}}
Accept: {{accept}}

{
  "storage_duration": "45 days"
}

### Admin — Retry failed TIRA submission
POST {{baseUrl}}/admin/tira/submissions/{{tiraSubmissionId}}/retry
Authorization: Bearer {{adminToken}}
Accept: {{accept}}


###############################################################################
# 12. SUGGESTED END-TO-END TEST FLOW
###############################################################################
# 1. loginCustomer → loginInsurer
# 2. GET countries, currencies, shipping-lines → set @countryId, @currencyId, @shippingLineId
# 3. GET policies (insurer) or createPolicy → set @policyId
# 4. GET insurer/company → set @insurerCompanyId from seeded data (often 1)
# 5. createOrder → steps 1-8 → submit
# 6. PATCH order status approved (insurer)
# 7. GET invoices → set @invoiceId → pay
# 8. php artisan queue:work (process SubmitPremiumToTira job)
# 9. loginTira → GET tira/premiums → reconcile
###############################################################################
