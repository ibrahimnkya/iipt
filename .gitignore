# ==========================================
# NIIS-T Monorepo Gitignore Configuration
# ==========================================

# 1. Dependency Directories
node_modules/
.pnpm-store/
.pnpm-debug.log*
jspm_packages/
web_modules/

# 2. Next.js Build Outputs
.next/
out/
dist/
build/
server-build/

# 3. Turborepo Caching & Outputs
.turbo/

# 4. Prisma Generator & Database Assets
/src/generated/prisma
/packages/db/src/generated
*.db
*.db-journal

# 5. Environment Variables & Secrets (Ignore all local configs, keep template if present)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
*.pem
*.key
*.cert

# 6. TypeScript Cache
*.tsbuildinfo
next-env.d.ts

# 7. IDE & Editor Specific Files
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# 8. OS-Specific System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# 9. Logs & Runtime Debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log
logs/

# 10. Testing & Coverage
coverage/
.nyc_output/
.jest/
htmlcov/
