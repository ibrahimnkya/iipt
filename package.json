{
  "name": "tiips-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run dev -w apps/api",
    "build": "npm run build --workspaces",
    "generate:db": "npm run generate -w packages/db"
  },
  "devDependencies": {
    "turbo": "latest"
  },
  "pnpm": {
    "overrides": {
      "prisma": "5.21.1",
      "@prisma/client": "5.21.1",
      "@prisma/adapter-pg": "5.21.1"
    }
  }
}