generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum OrderStatus {
  PENDING
  APPROVED
  ISSUED
  CANCELLED
}

enum InvoiceStatus {
  UNPAID
  PAID
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model User {
  id               String  @id @default(uuid())
  role             Role    @default(USER)
  fullName         String
  email            String  @unique
  password         String
  phone            String
  postalAddress    String?
  physicalAddress  String?
  brelaNumber      String?
  tinNumber        String?
  natureOfBusiness String?
  signature        String? // base64 or file path

  orders    Order[]
  payments  Payment[]
  createdAt DateTime  @default(now())
}

model InsurancePolicy {
  id          String  @id @default(uuid())
  name        String
  code        String  @unique
  clauseType  String // ICC A, B, C
  description String?
  isActive    Boolean @default(true)

  // Coverage Scope (JSON arrays)
  cargoTypes       Json? // ["General", "Fragile", etc.]
  transportModes   Json? // ["Sea", "Air", etc.]
  incoterms        Json? // ["CIF", "CFR", etc.]
  geoScope         String @default("Worldwide")
  originPorts      Json? // Array of port codes
  destinationPorts Json? // Array of port codes

  // Sum Insured & Valuation
  valuationBasis String @default("CIF")
  minSumInsured  Float?
  maxSumInsured  Float?
  currency       String @default("USD")

  // Premium & Rating
  rate          Float  @default(0) // Premium Rate (%)
  minPremium    Float?
  hazardLoading Float? // Optional loading (%)
  discount      Float? // Optional discount (%)
  vat           Float  @default(18) // Tanzania VAT (%)

  // Additional Covers
  additionalCovers Json? // [{"name": "War Risk", "type": "Flat", "amount": 100}]

  // Validity
  startDate   DateTime  @default(now())
  endDate     DateTime?
  autoInvoice Boolean   @default(true)
  autoIssue   Boolean   @default(true)

  // Admin Controls
  requiresManualApproval Boolean @default(false)
  internalNotes          String?

  createdAt DateTime @default(now())
  orders    Order[]
}

enum ValidationStatus {
  VALID
  HOLD
}

enum GateOutStatus {
  PENDING
  APPROVED
  NA
}

model Order {
  id       String      @id @default(uuid())
  userId   String
  policyId String
  status   OrderStatus @default(PENDING)

  // Declaration Details
  sadNumber        String?
  hsCode           String?
  validationStatus ValidationStatus @default(VALID)
  gateOutStatus    GateOutStatus    @default(NA)

  capacity String
  incoterm String

  cargoDescription String
  cargoNature      String
  packagingMethod  String
  totalWeight      String

  originPort        String
  destinationPort   String
  transportMode     String
  dispatchDate      DateTime
  transShipment     Boolean
  transShipmentNote String?

  vesselName  String?
  carrierName String?

  invoiceValue   Float
  currency       String
  valuationBasis String
  sumInsured     Float

  storageRequired Boolean
  storageDetails  String?

  claimsHistory Boolean
  claimsDetails String?

  invoice   Invoice?
  createdAt DateTime @default(now())

  user   User            @relation(fields: [userId], references: [id])
  policy InsurancePolicy @relation(fields: [policyId], references: [id])
}

model Invoice {
  id       String        @id @default(uuid())
  orderId  String        @unique
  amount   Float
  status   InvoiceStatus @default(UNPAID)
  issuedAt DateTime      @default(now())
  paidAt   DateTime?

  payments Payment[]
  order    Order     @relation(fields: [orderId], references: [id])
}

model Payment {
  id            String        @id @default(uuid())
  userId        String
  invoiceId     String
  provider      String // AZAM, YAS, AIRTEL, HALOTEL
  phoneNumber   String
  amount        Float
  status        PaymentStatus
  transactionId String?
  createdAt     DateTime      @default(now())

  user    User    @relation(fields: [userId], references: [id])
  invoice Invoice @relation(fields: [invoiceId], references: [id])
}
